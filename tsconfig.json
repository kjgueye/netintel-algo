{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Deliberately mirrors NetIntel's tsconfig. src/routes and src/utils are
    // byte-identical copies of NetIntel's, so this repo must compile them under
    // the same settings or `npm run sync:from-netintel` stops being viable:
    //   - no noUncheckedIndexedAccess / noImplicitOverride (upstream omits them)
    //   - no explicit "lib": the default for target ES2022 pulls in DOM, whose
    //     Body.json() is Promise<any>. Pinning lib to ["ES2022"] drops DOM, and
    //     fetch().json() degrades to Promise<unknown> — which breaks the copied
    //     routes (github-intel and friends) on every property access.
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
