# deps & build
node_modules/
dist/

# local env — the real .env (with PAYTO/network) must never be committed
.env
.env.*
!.env.example

# key material — the payer's 24-word phrase, read by scripts/seed-all.ts.
# NEVER commit. Ignored as a whole directory so no file under it can slip in.
.secrets/

# logs & scratch
*.log
.DS_Store

# throwaway local tooling — key derivation + ad-hoc payer. Never commit these
# (they exist to poke at mnemonics/HD paths and are not part of the service).
scripts/hd-scan.ts
scripts/pay-test.ts

# NOT ignored, and deliberately so — neither holds key material (the mnemonic is
# read from the MNEMONIC env var at run time; the only baked-in constant is the
# PUBLIC payout address, which every 402 response already advertises):
#   scripts/sync-from-netintel.ts — keeps src/routes + src/utils in step with NetIntel
#   scripts/seed-all.ts           — catalogs endpoints into the GoPlausible index

# demo recordings live in GitHub Releases, never in the tree
*.mp4
