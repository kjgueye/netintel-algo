# --- netintel-algo currency-exchange service ---
# Copy to .env and fill in. Nothing here is secret: this is a RECEIVE-ONLY
# seller. There is NO server signing key — settlement is done by the payer's
# wallet and the GoPlausible facilitator; the seller only names a payout address.

# Algorand address (58 chars) that receives the USDC payment (seller payout wallet).
# MAINNET: use a MainNet account you control that is opted in to USDC ASA 31566704.
PAYTO_ADDRESS=YOUR_58_CHAR_ALGORAND_ADDRESS

# CAIP-2 network id. Flip this (and PAYTO_ADDRESS) between nets — no code change.
# The USDC ASA is derived from this network by the SDK (not hardcoded):
#   MAINNET (default): algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=  (USDC ASA 31566704)
#   TESTNET:           algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=  (USDC ASA 10458941)
X402_NETWORK=algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=

# Port the HTTP server listens on (Railway injects PORT in production).
PORT=3000

# Optional: canonical origin advertised by the discovery artifacts (llms.txt,
# /.well-known/x402, agent-card.json, openapi.json). When unset, artifacts
# advertise the request's own scheme + Host. Set on Railway to the custom domain.
# PUBLIC_BASE_URL=https://algo.netintel.dev

# Optional: Postgres for paid-call analytics (the same Railway Postgres as the
# main NetIntel project — this service only ever writes its own algo_* tables:
# algo_paid_call_events / algo_paid_call_failures / algo_paid_call_misses).
# Without it the service still works fully; events fall back to local NDJSON
# files + tagged stdout lines (ALGO_PAID_CALL_EVENT / _FAILURE / ALGO_MISS_EVENT).
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# --- Upstream API keys (used by the LLM/image endpoints; secrets, never commit) ---
# Anthropic key — required by /schema-parse/extract, /sentiment/analyze,
# /messages, and the prompt-engineering pass of /ai-image/generate.
# Without it the service still boots and serves 402s, but those handlers
# return 502 when actually invoked.
ANTHROPIC_API_KEY=

# OpenAI key — required by /ai-image/generate to render the image (gpt-image-1).
# Without it that handler returns 503 "Image generation is not configured".
OPENAI_API_KEY=

# Optional overrides:
#   OPENAI_IMAGE_MODEL=gpt-image-1     (image model; default shown)
#   IMAGE_PROVIDER=openai              (image provider; only "openai" in v1)
#   WALLET_DENYLIST=addr1,addr2        (comma-separated payer wallets to block on /ai-image/generate)
